--- !u!114 &1282846673
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1282846671}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "THE END\r\n\r\n\r\n\uB9C8\uCE68\uB0B4, \uAE34 \uC5EC\uC815\uC774 \uB05D\uB0AC\uC2B5\uB2C8\uB2E4.\r\n\r\n\uC218\uB9CE\uC740
    \uBCC4\uACFC \uD589\uC131\uC744 \uC9C0\uB098\r\n\r\n\uC6B0\uC8FC\uC120\uC740
    \uBB34\uC0AC\uD788 \uBAA9\uC801\uC9C0\uC5D0 \uB3C4\uCC29\uD588\uC2B5\uB2C8\uB2E4.\r\n\r\n\uD558\uC9C0\uB9CC
    \uC774\uACF3\uC740 \uC6B0\uC8FC\uC758 \uB05D\uC774 \uC544\uB2D9\uB2C8\uB2E4.\r\n\r\n\uB610
    \uB2E4\uB978 \uBCC4\uACFC \uC0C8\uB85C\uC6B4 \uBAA8\uD5D8\uC774 \uB2F9\uC2E0\uC744
    \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC744\uC9C0\uB3C4 \uBAA8\uB985\uB2C8\uB2E4.\r\n\r\n\uB05D\uAE4C\uC9C0
    \uD568\uAED8\uD574 \uC8FC\uC154\uC11C \uAC10\uC0AC\uD569\uB2C8\uB2E4.\r\n\r\nTHANK
    YOU FOR PLAYING\r\n\r\nGAME DIRECTOR\r\n\r\n\uCD5C\uC131\uC6B1\r\n\r\nGAME DESIGN\r\n\r\n\uC2E0\uB3D9\uADDC&\uBC29\uC2B9\uC900\r\n\r\nPROGRAMMING\r\n\r\n\uB098\uAC15\uC724&\uCD5C\uC131\uC6B1\r\n\r\nLEVEL
    DESIGN\r\n\r\n\uCD5C\uC131\uC6B1\r\n\r\nART & VISUAL DESIGN\r\n\r\n\uC2E0\uB3D9\uADDC&\uBC29\uC2B9\uC900\r\n\r\nUI
    / UX DESIGN\r\n\r\n\uB098\uAC15\uC724\r\n\r\nSOUND DESIGN\r\n\r\n\uB098\uAC15\uC724\r\n\r\nBACKGROUND
    MUSIC\r\n\r\n\uCD5C\uC131\uC6B1\r\n\r\nSPECIAL THANKS\r\n\r\n\uAC8C\uC784\uC744
    \uD50C\uB808\uC774\uD574 \uC8FC\uC2E0 \uBAA8\uB4E0 \uBD84\uB4E4\r\n\uB3C4\uC6C0\uC744
    \uC8FC\uC2E0 \uC120\uC0DD\uB2D8\uACFC \uCE5C\uAD6C\uB4E4\r\n\uADF8\uB9AC\uACE0
    \uAC1C\uBC1C\uC744 \uB05D\uAE4C\uC9C0 \uC751\uC6D0\uD574 \uC8FC\uC2E0 \uBAA8\uB4E0
    \uBD84\uB4E4\r\n\r\nDEVELOPED BY\r\n\r\n\uCD5C\uC2E0\uBC29\r\n\r\nPOWERED BY\r\n\r\nUnity\r\n\r\n\uB2F9\uC2E0\uC758
    \uC5EC\uC815\uC740 \uC5EC\uAE30\uC11C \uB05D\uB098\uC9C0\uB9CC,\r\n\uC6B0\uC8FC\uC5D0\uB294
    \uC544\uC9C1 \uC218\uB9CE\uC740 \uC774\uC57C\uAE30\uAC00 \uB0A8\uC544 \uC788\uC2B5\uB2C8\uB2E4.\r\n\r\nSEE
    YOU AMONG THE STARS\r\n\r\n\xA9 2026 \uCD5C\uC2E0\uBC29. All Rights Reserved."
