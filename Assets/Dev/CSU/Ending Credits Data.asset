  gameTitle: "\uBAAC\uD0C0\uC7BC"
  developerName: "\uCD5C\uC2E0\uBC29"
  creditsTemplate: "THE END\n\n\n\n\n\uB9C8\uCE68\uB0B4, \uAE34 \uC5EC\uC815\uC774
    \uB05D\uB0AC\uC2B5\uB2C8\uB2E4.\n\n\n\n\uC218\uB9CE\uC740 \uBCC4\uACFC \uD589\uC131\uC744
    \uC9C0\uB098 \uC6B0\uC8FC\uC120\uC740 \uBB34\uC0AC\uD788 \uBAA9\uC801\uC9C0\uC5D0
    \uB3C4\uCC29\uD588\uC2B5\uB2C8\uB2E4. \n\n\n\uD558\uC9C0\uB9CC \uC774\uACF3\uC740
    \uC6B0\uC8FC\uC758 \uB05D\uC774 \uC544\uB2D9\uB2C8\uB2E4.\n\n\n\n\uB610 \uB2E4\uB978
    \uBCC4\uACFC \uC0C8\uB85C\uC6B4 \uBAA8\uD5D8\uC774 \uB2F9\uC2E0\uC744 \uAE30\uB2E4\uB9AC\uACE0
    \uC788\uC744\uC9C0\uB3C4 \uBAA8\uB985\uB2C8\uB2E4.\n\n\n\n\uB05D\uAE4C\uC9C0
    \uD568\uAED8\uD574 \uC8FC\uC154\uC11C \uAC10\uC0AC\uD569\uB2C8\uB2E4.\n\n\n\nTHANK
    YOU FOR PLAYING\n\n\n\nGAME DIRECTOR\n\n\uCD5C\uC131\uC6B1\n\n\n\nGAME DESIGN\n\n\n\uC2E0\uB3D9\uADDC&\uBC29\uC2B9\uC900\n\n\n\nPROGRAMMING\n\n\uB098\uAC15\uC724&\uCD5C\uC131\uC6B1\n\n\n\nLEVEL
    DESIGN\n\n\uCD5C\uC131\uC6B1\n\n\n\nART & VISUAL DESIGN\n\n\uC2E0\uB3D9\uADDC&\uBC29\uC2B9\uC900\n\n\nUI
    DESIGN\n\n\uC2E0\uB3D9\uADDC&\uBC29\uC2B9\uC900\n\n\nUI\n\n\uB098\uAC15\uC724\n\n\nUX
